# Data & artifacts (regenerated; not committed except small manifests/results)
# Root-level only, so the molsanity/data package is NOT ignored.
/data/
/logs/

# Ignore artifacts/ contents, but COMMIT pretrained checkpoints so examiners can
# resume / rerun the audit without retraining (see README "Pretrained
# checkpoints"). The re-include at the bottom of this file wins over the *.pt /
# *.pth globals because the last matching pattern decides in .gitignore.
/artifacts/*
!/artifacts/checkpoints/

*.ckpt
*.pt
*.pth

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# OS / editor
.DS_Store
.ipynb_checkpoints/

# Keep committed figures/results explicitly (see below)
!RESULTS.md

# figures/ is the single browsable home for every generated figure (vector
# PDF+SVG, mirrored from artifacts/figures by molsanity.viz.collect). Tracked
# on purpose so the visual record is reviewable without running the pipeline.
!/figures/
!/figures/**

# Committed pretrained checkpoints (must be the LAST word so the *.pt/*.pth and
# /artifacts/* rules above do not re-exclude them). Both the working copy and
# the archived copy under results/ are tracked, so "can you share your
# checkpoints?" is answered by the clone itself — see paper/README.md.
!/artifacts/checkpoints/**
!/results/artifacts/checkpoints/**

# Built by "make -C paper zip"; regenerated on demand, never committed.
paper/molsanity_supplementary.zip

# Journal submission package; rebuilt by "make -C paper submission-files".
paper/submission/
